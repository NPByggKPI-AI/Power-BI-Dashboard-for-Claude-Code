                      "fontSize": "6pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Data & refresh",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "18pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "All data is read directly from your local ~/.claude folder via a single Power Query parameter (ClaudeHomePath) — nothing leaves your machine. To see the latest activity, refresh the report in Power BI Desktop after using Claude Code.",
