              {
                "textRuns": [
                  {
                    "value": "What this report shows",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "18pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "This dashboard analyzes local Claude Code usage data from ~/.claude — prompts and sessions, token usage and estimated cost, tool calls and subagent orchestration (tasks and teams), and environment details (installed plugins, marketplaces, live sessions, and file-edit history).",
                    "textStyle": {
                      "fontSize": "13pt"
                    }
                  }
                ]
              },
