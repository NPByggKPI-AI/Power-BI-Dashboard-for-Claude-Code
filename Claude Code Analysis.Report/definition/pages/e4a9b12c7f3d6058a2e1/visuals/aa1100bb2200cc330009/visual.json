                      "fontSize": "6pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "How to use it",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "18pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Use the navigation buttons on the Home page, or the page tabs at the bottom, to move between Usage, Performance, Orchestration, and Environment. Most pages share a Project and Date slicer, kept in sync across pages — filtering on one page carries over to the others.",
                    "textStyle": {
                      "fontSize": "13pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
