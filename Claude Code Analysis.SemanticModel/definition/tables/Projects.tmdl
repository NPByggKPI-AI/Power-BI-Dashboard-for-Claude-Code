	partition Projects = m
		mode: import
		source =
				let
				    Source = Folder.Files(ClaudeHomePath & "\projects"),
				    #"Added Custom" = Table.AddColumn(Source, "Subsession", each if Text.End([Folder Path],10) = "subagents\" then "subagents" else if Text.End([Folder Path],7) = "memory\" then "memory" else if Text.End([Folder Path],13) = "tool-results\" then "tool-results" else "")
				in
				    #"Added Custom"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

