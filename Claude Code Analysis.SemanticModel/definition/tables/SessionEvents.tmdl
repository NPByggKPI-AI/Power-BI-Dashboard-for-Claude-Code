table SessionEvents
	lineageTag: 6343817b-e486-4f1b-a5d1-7987d38af417

	/// Sum of input tokens consumed across all assistant responses.
	measure 'Total Input Tokens' = SUM(SessionEvents[inputTokens])
		formatString: #,0
		displayFolder: Performance Measures
		lineageTag: fa828d3c-c0dc-4c98-886d-b2d5a7bf24c7

	/// Sum of output tokens generated across all assistant responses.
	measure 'Total Output Tokens' = SUM(SessionEvents[outputTokens])
		formatString: #,0
		displayFolder: Performance Measures
		lineageTag: b770d263-003b-4e43-861c-b2dfc36b835e

	/// Sum of tokens written to the prompt cache across all assistant responses.
	measure 'Total Cache Creation Tokens' = SUM(SessionEvents[cacheCreationTokens])
		formatString: #,0
		displayFolder: Performance Measures
		lineageTag: 36013e28-877e-4d9d-989d-d1eb9ec227c0

	/// Sum of tokens served from the prompt cache across all assistant responses.
	measure 'Total Cache Read Tokens' = SUM(SessionEvents[cacheReadTokens])
		formatString: #,0
		displayFolder: Performance Measures
		lineageTag: c0379000-ef4d-4108-816f-ff7479f95a11

	/// Sum of input, output, cache-creation, and cache-read tokens combined.
	measure 'Total Tokens (All)' = [Total Input Tokens] + [Total Output Tokens] + [Total Cache Creation Tokens] + [Total Cache Read Tokens]
		formatString: #,0
		displayFolder: Performance Measures
		lineageTag: 03052532-8dac-4e75-89cb-0acfe4ee93f5

	/// Estimated USD cost, computed per event at its own model's rate from ModelRates before summing (not a blended average rate).
	measure 'Estimated Cost' =
			SUMX(
			    SessionEvents,
			    VAR ModelName = SessionEvents[model]
			    VAR InputRate = LOOKUPVALUE(ModelRates[InputRatePerMTok], ModelRates[Model], ModelName)
			    VAR OutputRate = LOOKUPVALUE(ModelRates[OutputRatePerMTok], ModelRates[Model], ModelName)
			    VAR CacheWriteRate = LOOKUPVALUE(ModelRates[CacheWriteRatePerMTok], ModelRates[Model], ModelName)
			    VAR CacheReadRate = LOOKUPVALUE(ModelRates[CacheReadRatePerMTok], ModelRates[Model], ModelName)
			    RETURN
			        DIVIDE(SessionEvents[inputTokens] * InputRate, 1000000)
			        + DIVIDE(SessionEvents[outputTokens] * OutputRate, 1000000)
			        + DIVIDE(SessionEvents[cacheCreationTokens] * CacheWriteRate, 1000000)
			        + DIVIDE(SessionEvents[cacheReadTokens] * CacheReadRate, 1000000)
			)
		formatString: $#,0.00
		displayFolder: Performance Measures
		lineageTag: 61cee6d6-1e9c-42c3-8f00-b4bc4d450493

	/// Count of user-authored turns (prompts) in the session transcripts.
	measure 'User Turn Count' = CALCULATE(COUNTROWS(SessionEvents), SessionEvents[EventType] = "user")
		formatString: #,0
		displayFolder: Performance Measures
		lineageTag: 00cdbe5f-5feb-4a2e-bc25-fe231d7ba8da

