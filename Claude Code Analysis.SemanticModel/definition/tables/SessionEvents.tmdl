	partition SessionEvents = m
		mode: import
		source =
				let
				    Source = Projects,
				    FilteredExtension = Table.SelectRows(Source, each [Extension] = ".jsonl"),
				    AddedLines = Table.AddColumn(FilteredExtension, "Lines", each Lines.FromBinary([Content], null, null, 1252)),
				    SelectedCols = Table.SelectColumns(AddedLines, {"Name", "Folder Path", "Lines"}),
				    ExpandedLines = Table.ExpandListColumn(SelectedCols, "Lines"),
				    RenamedLine = Table.RenameColumns(ExpandedLines, {{"Lines", "RawLine"}}),
				    NonEmpty = Table.SelectRows(RenamedLine, each [RawLine] <> null and Text.Trim([RawLine]) <> ""),
				    AddedParsed = Table.AddColumn(NonEmpty, "Record", each try Json.Document(Text.ToBinary([RawLine])) otherwise null),
				    ValidRecords = Table.SelectRows(AddedParsed, each [Record] <> null and Value.Is([Record], type record)),
				    AddedEventType = Table.AddColumn(ValidRecords, "EventType", each Record.FieldOrDefault([Record], "type", null)),
				    FilteredType = Table.SelectRows(AddedEventType, each [EventType] = "user" or [EventType] = "assistant"),
				    AddedFields = Table.AddColumn(FilteredType, "Fields", each
				        let
				            rec = [Record],
				            msg = Record.FieldOrDefault(rec, "message", null),
				            msgIsRecord = msg <> null and Value.Is(msg, type record),
				            usage = if msgIsRecord then Record.FieldOrDefault(msg, "usage", null) else null,
				            usageIsRecord = usage <> null and Value.Is(usage, type record)
				        in [
				            sessionId = Record.FieldOrDefault(rec, "sessionId", null),
				            timestampText = Record.FieldOrDefault(rec, "timestamp", null),
				            cwd = Record.FieldOrDefault(rec, "cwd", null),
				            gitBranch = Record.FieldOrDefault(rec, "gitBranch", null),
				            version = Record.FieldOrDefault(rec, "version", null),
				            entrypoint = Record.FieldOrDefault(rec, "entrypoint", null),
				            promptSource = Record.FieldOrDefault(rec, "promptSource", null),
				            model = if msgIsRecord then Record.FieldOrDefault(msg, "model", null) else null,
				            inputTokens = if usageIsRecord then Record.FieldOrDefault(usage, "input_tokens", null) else null,
				            outputTokens = if usageIsRecord then Record.FieldOrDefault(usage, "output_tokens", null) else null,
				            cacheCreationTokens = if usageIsRecord then Record.FieldOrDefault(usage, "cache_creation_input_tokens", null) else null,
				            cacheReadTokens = if usageIsRecord then Record.FieldOrDefault(usage, "cache_read_input_tokens", null) else null
				        ]
				    ),
				    Expanded = Table.ExpandRecordColumn(AddedFields, "Fields", {"sessionId","timestampText","cwd","gitBranch","version","entrypoint","promptSource","model","inputTokens","outputTokens","cacheCreationTokens","cacheReadTokens"}),
				    RemovedHelpers = Table.SelectColumns(Expanded, {"Name","Folder Path","EventType","sessionId","timestampText","cwd","gitBranch","version","entrypoint","promptSource","model","inputTokens","outputTokens","cacheCreationTokens","cacheReadTokens"}),
				    AddedTimestamp = Table.AddColumn(RemovedHelpers, "EventTimestamp", each try DateTimeZone.RemoveZone(DateTimeZone.From([timestampText])) otherwise null),
				    RemovedTimestampText = Table.RemoveColumns(AddedTimestamp, {"timestampText"}),
				    ChangedTypes = Table.TransformColumnTypes(RemovedTimestampText, {
				        {"Name", type text}, {"Folder Path", type text}, {"EventType", type text}, {"sessionId", type text},
				        {"cwd", type text}, {"gitBranch", type text}, {"version", type text}, {"entrypoint", type text},
				        {"promptSource", type text}, {"model", type text}, {"inputTokens", Int64.Type}, {"outputTokens", Int64.Type},
				        {"cacheCreationTokens", Int64.Type}, {"cacheReadTokens", Int64.Type}, {"EventTimestamp", type datetime}
				    }),
				    AddedDate = Table.AddColumn(ChangedTypes, "EventDate", each try Date.From([EventTimestamp]) otherwise null, type date),
				    Renamed = Table.RenameColumns(AddedDate, {{"Name","FileName"},{"Folder Path","ProjectFolderPath"}})
				in
				    Renamed

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

