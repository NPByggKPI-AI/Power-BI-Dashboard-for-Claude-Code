		annotation SummarizationSetBy = Automatic

	partition Plugins = m
		mode: import
		source =
				let
				    Source = Json.Document(File.Contents(ClaudeHomePath & "\plugins\installed_plugins.json")),
				    pluginsRecord = Record.FieldOrDefault(Source, "plugins", [ ]),
				    AsTable = Record.ToTable(pluginsRecord),
				    ExpandedList = Table.ExpandListColumn(AsTable, "Value"),
				    AddedFields = Table.AddColumn(ExpandedList, "Fields", each
				        let
				            rec = [Value]
				        in [
				            scope = Record.FieldOrDefault(rec, "scope", null),
				            installPath = Record.FieldOrDefault(rec, "installPath", null),
				            version = Record.FieldOrDefault(rec, "version", null),
				            installedAtText = Record.FieldOrDefault(rec, "installedAt", null),
				            lastUpdatedText = Record.FieldOrDefault(rec, "lastUpdated", null),
				            gitCommitSha = Record.FieldOrDefault(rec, "gitCommitSha", null),
				            projectPath = Record.FieldOrDefault(rec, "projectPath", null)
				        ]
				    ),
				    Expanded = Table.ExpandRecordColumn(AddedFields, "Fields", {"scope","installPath","version","installedAtText","lastUpdatedText","gitCommitSha","projectPath"}),
				    RenamedKey = Table.RenameColumns(Expanded, {{"Name", "pluginKey"}}),
				    SplitKey = Table.SplitColumn(RenamedKey, "pluginKey", Splitter.SplitTextByDelimiter("@", QuoteStyle.Csv), {"pluginName", "marketplaceName"}),
				    AddedInstalledAt = Table.AddColumn(SplitKey, "InstalledAt", each try DateTimeZone.RemoveZone(DateTimeZone.From([installedAtText])) otherwise null),
				    AddedLastUpdated = Table.AddColumn(AddedInstalledAt, "LastUpdated", each try DateTimeZone.RemoveZone(DateTimeZone.From([lastUpdatedText])) otherwise null),
				    RemovedHelper = Table.RemoveColumns(AddedLastUpdated, {"Value", "installedAtText", "lastUpdatedText"}),
				    ChangedTypes = Table.TransformColumnTypes(RemovedHelper, {
				        {"pluginName", type text}, {"marketplaceName", type text}, {"scope", type text}, {"installPath", type text},
				        {"version", type text}, {"InstalledAt", type datetime}, {"LastUpdated", type datetime},
				        {"gitCommitSha", type text}, {"projectPath", type text}
				    })
				in
				    ChangedTypes

	annotation PBI_ResultType = Table

