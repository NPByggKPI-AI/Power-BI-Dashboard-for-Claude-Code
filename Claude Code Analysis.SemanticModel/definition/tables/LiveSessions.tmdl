	partition LiveSessions = m
		mode: import
		source =
				let
				    Source = Folder.Files(ClaudeHomePath & "\sessions"),
				    FilteredJson = Table.SelectRows(Source, each [Extension] = ".json"),
				    AddedContentText = Table.AddColumn(FilteredJson, "ContentText", each Text.FromBinary([Content])),
				    AddedParsed = Table.AddColumn(AddedContentText, "Record", each try Json.Document([ContentText]) otherwise null),
				    ValidRecords = Table.SelectRows(AddedParsed, each [Record] <> null and Value.Is([Record], type record)),
				    AddedFields = Table.AddColumn(ValidRecords, "Fields", each
				        let rec = [Record] in [
				            pid = Record.FieldOrDefault(rec, "pid", null),
				            sessionId = Record.FieldOrDefault(rec, "sessionId", null),
				            cwd = Record.FieldOrDefault(rec, "cwd", null),
				            version = Record.FieldOrDefault(rec, "version", null),
				            kind = Record.FieldOrDefault(rec, "kind", null),
				            entrypoint = Record.FieldOrDefault(rec, "entrypoint", null),
				            name = Record.FieldOrDefault(rec, "name", null),
				            status = Record.FieldOrDefault(rec, "status", null),
				            startedAtMs = Record.FieldOrDefault(rec, "startedAt", null)
				        ]
				    ),
				    Expanded = Table.ExpandRecordColumn(AddedFields, "Fields", {"pid","sessionId","cwd","version","kind","entrypoint","name","status","startedAtMs"}),
				    RemovedHelpers = Table.SelectColumns(Expanded, {"pid","sessionId","cwd","version","kind","entrypoint","name","status","startedAtMs"}),
				    AddedStartedAt = Table.AddColumn(RemovedHelpers, "StartedAt", each try #datetime(1970,1,1,0,0,0) + #duration(0,0,0,[startedAtMs]/1000) otherwise null),
				    RemovedMs = Table.RemoveColumns(AddedStartedAt, {"startedAtMs"}),
				    ChangedTypes = Table.TransformColumnTypes(RemovedMs, {
				        {"pid", Int64.Type}, {"sessionId", type text}, {"cwd", type text}, {"version", type text},
				        {"kind", type text}, {"entrypoint", type text}, {"name", type text},
				        {"status", type text}, {"StartedAt", type datetime}
				    })
				in
				    ChangedTypes

	annotation PBI_ResultType = Table

