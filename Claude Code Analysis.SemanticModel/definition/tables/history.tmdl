table history
	lineageTag: 9574420d-1b9b-4dd6-87c6-4efa7b6a9291

	/// Total number of prompts submitted, across all sessions and projects.
	measure 'Total Prompts' = COUNTROWS(history)
		formatString: #,0
		displayFolder: Usage Measures
		lineageTag: 14b17858-c507-415d-aec6-891054d556bf

	/// Count of distinct sessions represented in the prompt history log.
	measure 'Distinct Sessions' = DISTINCTCOUNT(history[sessionId])
		formatString: #,0
		displayFolder: Usage Measures
		lineageTag: dd56eca0-b935-447d-ae99-b9aaae49629c

	/// Count of distinct projects (working directories) represented in the prompt history log.
	measure 'Distinct Projects' = DISTINCTCOUNT(history[project])
		formatString: #,0
		displayFolder: Usage Measures
		lineageTag: c220bd03-43f8-40d6-a193-25e66a1b68b9

