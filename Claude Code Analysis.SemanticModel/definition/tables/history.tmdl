	partition history = m
		mode: import
		source =
				let
				    Source = Table.FromColumns({Lines.FromBinary(File.Contents(ClaudeHomePath & "\history.jsonl"), null, null)}),
				    #"Transformed Column" = Table.TransformColumns(Source, {"Column1", Json.Document}),
				    #"Expanded Column1" = Table.ExpandRecordColumn(#"Transformed Column", "Column1", {"display", "pastedContents", "timestamp", "project", "sessionId"}, {"display", "pastedContents", "timestamp", "project", "sessionId"}),
				    #"Expanded pastedContents" = Table.ExpandRecordColumn(#"Expanded Column1", "pastedContents", {"1", "2"}, {"pastedContents.1", "pastedContents.2"}),
				    #"Expanded pastedContents.1" = Table.ExpandRecordColumn(#"Expanded pastedContents", "pastedContents.1", {"id", "type", "content"}, {"id1", "type1", "content1"}),
				    #"Expanded pastedContents.2" = Table.ExpandRecordColumn(#"Expanded pastedContents.1", "pastedContents.2", {"id", "type", "content"}, {"id2", "type2", "content2"}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Expanded pastedContents.2",{{"display", type text}, {"id1", Int64.Type}, {"type1", type text}, {"content1", type text}, {"id2", type any}, {"type2", type any}, {"content2", type any}, {"timestamp", Int64.Type}, {"project", type text}, {"sessionId", type text}}),
				    #"Added Custom" = Table.AddColumn(#"Changed Type", "TimeDate", each #datetime(1970, 1, 1, 0, 0, 0) + #duration(0, 0, 0, [timestamp]/ 1000)),
				    #"Added Custom1" = Table.AddColumn(#"Added Custom", "Date", each Date.From(#datetime(1970, 1, 1, 0, 0, 0) + #duration(0, 0, 0, [timestamp] / 1000))),
				    #"Changed Type1" = Table.TransformColumnTypes(#"Added Custom1",{{"TimeDate", type datetime}, {"Date", type date}}),
				    #"Duplicated Column" = Table.DuplicateColumn(#"Changed Type1", "project", "link"),
				    #"Split Column by Delimiter" = Table.SplitColumn(#"Duplicated Column", "project", Splitter.SplitTextByEachDelimiter({"\"}, QuoteStyle.Csv, true), {"folder", "project"}),
				    #"Changed Type2" = Table.TransformColumnTypes(#"Split Column by Delimiter",{{"folder", type text}, {"project", type text}})
				in
				    #"Changed Type2"

	annotation PBI_NavigationStepName = Navigation

