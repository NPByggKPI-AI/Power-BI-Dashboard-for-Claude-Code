table TeamMembers
	lineageTag: eff3e0d1-cf66-4118-8dd3-63ae96f17cf3

	/// Count of team member records across all teams.
	measure 'Team Member Count' = COUNTROWS(TeamMembers)
		formatString: #,0
		displayFolder: Orchestration Measures
		lineageTag: 02e3860f-0b59-44a4-920a-0e67a573cdb6

	column teamName
		dataType: string
		isHidden
		lineageTag: 8a79c742-720d-49a4-b329-20bada2de396
		summarizeBy: none
		sourceColumn: teamName

		annotation SummarizationSetBy = Automatic

	column agentId
		dataType: string
		lineageTag: 16910a61-248c-4700-80b3-14abf077ecb1
		summarizeBy: none
		sourceColumn: agentId

		annotation SummarizationSetBy = Automatic

	column memberName
		dataType: string
		lineageTag: 27169f73-0d36-4216-af99-6c7d742ebf97
		summarizeBy: none
		sourceColumn: memberName

		annotation SummarizationSetBy = Automatic

	column agentType
		dataType: string
		lineageTag: 5a8798d0-b9be-470f-a0b1-3e29c0e0ce32
		summarizeBy: none
		sourceColumn: agentType

		annotation SummarizationSetBy = Automatic

	column cwd
		dataType: string
		lineageTag: db908644-f5c1-418c-9a6e-007c7fe08543
		summarizeBy: none
		sourceColumn: cwd

		annotation SummarizationSetBy = Automatic

	column backendType
		dataType: string
		lineageTag: b3db0392-91ef-4dda-b07f-7d4373e0535f
		summarizeBy: none
		sourceColumn: backendType

		annotation SummarizationSetBy = Automatic

	column JoinedAt
		dataType: dateTime
		lineageTag: f9a0ee53-4170-4cec-aa7e-948219cbbb37
		summarizeBy: none
		sourceColumn: JoinedAt

		variation Variation
			isDefault
			relationship: 0211c35f-8eee-434b-bbf8-6f39576a2476
			defaultHierarchy: LocalDateTable_5b7cd8f9-a494-4add-9a47-2cb53ac0e40e.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	partition TeamMembers = m
		mode: import
		source =
				let
				    Source = Folder.Files(ClaudeHomePath & "\teams"),
				    FilteredJson = Table.SelectRows(Source, each [Name] = "config.json"),
				    AddedContentText = Table.AddColumn(FilteredJson, "ContentText", each Text.FromBinary([Content])),
				    AddedParsed = Table.AddColumn(AddedContentText, "Record", each try Json.Document([ContentText]) otherwise null),
				    ValidRecords = Table.SelectRows(AddedParsed, each [Record] <> null and Value.Is([Record], type record)),
				    AddedTeamName = Table.AddColumn(ValidRecords, "teamName", each Record.FieldOrDefault([Record], "name", null)),
				    AddedMembers = Table.AddColumn(AddedTeamName, "MembersList", each
				        let m = Record.FieldOrDefault([Record], "members", null) in if m <> null and Value.Is(m, type list) then m else {}
				    ),
				    ExpandedMembers = Table.ExpandListColumn(AddedMembers, "MembersList"),
				    AddedFields = Table.AddColumn(ExpandedMembers, "Fields", each
				        let
				            m = [MembersList]
				        in [
				            agentId = Record.FieldOrDefault(m, "agentId", null),
				            memberName = Record.FieldOrDefault(m, "name", null),
				            agentType = Record.FieldOrDefault(m, "agentType", null),
				            joinedAtMs = Record.FieldOrDefault(m, "joinedAt", null),
				            cwd = Record.FieldOrDefault(m, "cwd", null),
				            backendType = Record.FieldOrDefault(m, "backendType", null)
				        ]
				    ),
				    Expanded = Table.ExpandRecordColumn(AddedFields, "Fields", {"agentId","memberName","agentType","joinedAtMs","cwd","backendType"}),
				    RemovedHelpers = Table.SelectColumns(Expanded, {"teamName","agentId","memberName","agentType","joinedAtMs","cwd","backendType"}),
				    AddedJoinedAt = Table.AddColumn(RemovedHelpers, "JoinedAt", each try #datetime(1970,1,1,0,0,0) + #duration(0,0,0,[joinedAtMs]/1000) otherwise null),
				    RemovedMs = Table.RemoveColumns(AddedJoinedAt, {"joinedAtMs"}),
				    ChangedTypes = Table.TransformColumnTypes(RemovedMs, {
				        {"teamName", type text}, {"agentId", type text}, {"memberName", type text}, {"agentType", type text},
				        {"cwd", type text}, {"backendType", type text}, {"JoinedAt", type datetime}
				    })
				in
				    ChangedTypes

	annotation PBI_ResultType = Table

